<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/theme_primary_top">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="地图"
            android:textColor="@color/c12"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/map_list_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_list_button" />


        <ImageView
            android:id="@+id/map_add_view"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="20dp"
            android:visibility="gone"
            android:src="@drawable/ic_jia" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--  <wendu.dsbridge.DWebView
            android:id="@+id/dwebview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />-->

        <com.baidu.mapapi.map.MapView
            android:id="@+id/baidu_mapview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginRight="10dp"
            android:layout_marginTop="40dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/weixing_layout"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:background="@drawable/bg_map_button"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weixing_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="卫星"
                    android:textColor="@color/c12"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/weixing_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weixing_list_view"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="火情     列表"
                        android:textColor="@color/c12"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/weixing_chaxun_ciew"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="火情     查询"
                        android:textColor="@color/c12"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/weixing_shezhi_view"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="卫星     设置"
                        android:textColor="@color/c12"
                        android:textSize="14sp" />

                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ziyuan_layout"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_map_button"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ziyuan_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="资源"
                    android:textColor="@color/c12"
                    android:visibility="gone"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/ziyuan_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/retype_view"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="资源"
                        android:textColor="@color/c12"
                        android:textSize="14sp" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/onebady_layout"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_map_button"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/onebody_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="报警     列表"
                    android:visibility="gone"
                    android:textColor="@color/c12"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/onebody_button_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/onebody_view"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="报警"
                        android:textColor="@color/c12"
                        android:textSize="14sp" />


                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ddrw_layout"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_map_button"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ddrw_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="任务"
                    android:textColor="@color/c12"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statistics_layout"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_map_button"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statistics_button"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="统计"
                    android:textColor="@color/c12"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>


        <Button
            android:id="@+id/button_near"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="50dp"
            android:text=" + "
            android:visibility="gone" />

        <Button
            android:id="@+id/button_far"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text=" - "
            android:visibility="gone" />

        <ImageView
            android:id="@+id/warn_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginRight="30dp"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_warning" />
        <ImageView
            android:id="@+id/order_warn_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:visibility="gone"
            android:src="@drawable/ic_warning" />
    </FrameLayout>
</LinearLayout>