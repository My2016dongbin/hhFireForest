<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/dialog_map_list"
    android:background="@color/theme_primary_list">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/theme_primary_list">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能管理"
            android:textSize="15sp"
            android:textColor="@color/c12"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"/>
        <ImageView
            android:id="@+id/list_dialog_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_list_button" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="图层选择"
        android:textColor="@color/c12"
        android:textSize="17sp"
        android:layout_marginLeft="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tiandi_yingxiang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tiandi_yingxiang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_tdt_yx" />

            <TextView
                android:id="@+id/tiandi_yingxiang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="天地图中文标记"
                android:textColor="@color/c12"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiandi_shiliang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tiandi_shiliang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_tdt_sl" />

            <TextView
                android:id="@+id/tiandi_shiliang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="天地图矢量"
                android:textColor="@color/c12"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/guge_yingxiang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/guge_yingxiang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_google_sl_select" />

            <TextView
                android:id="@+id/guge_yingxiang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本地影像"
                android:textSize="15sp"
                android:layout_marginTop="1dp"
                android:textColor="@color/map"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/zhanwei"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
        </LinearLayout>
        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/guge_gaocheng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <!--<ImageView-->
            <!--android:id="@+id/guge_gaocheng_image"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_marginLeft="5dp"-->
            <!--android:layout_marginRight="5dp"-->
            <!--android:src="@drawable/ic_google_gc"/>-->

            <!--<TextView-->
            <!--android:id="@+id/gugegaocheng_text"-->
            <!--android:layout_width="wrap_content"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:text="谷歌高程"-->
            <!--android:textSize="15sp"-->
            <!--android:layout_marginTop="10dp"-->
            <!--android:textColor="@color/c7"/>-->
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="模块管理"
        android:textColor="@color/c12"
        android:textSize="17sp"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="10dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"
        android:layout_marginTop="10dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卫星模块"
            android:textSize="15sp"
            android:textColor="@color/c12"/>
        <Switch
            android:id="@+id/weixing_switch"
            android:textColor="@color/theme_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/switch_selector_lan"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="10dp"
            android:thumb="@drawable/switch_white_circle_selector"
            android:checked="true"
            />
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="资源模块"
            android:textColor="@color/c12"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/ziyuan_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="10dp"
            android:textColor="@color/theme_primary"
            android:thumb="@drawable/switch_white_circle_selector"
            android:track="@drawable/switch_selector_lan"
            android:checked="true"/>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:padding="10dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一体机火情模块"
            android:textSize="15sp"
            android:textColor="@color/c12"/>
        <Switch
            android:id="@+id/yitiji_switch"
            android:textColor="@color/theme_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/switch_selector_lan"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="10dp"
            android:thumb="@drawable/switch_white_circle_selector"
            android:checked="true"
            />
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:background="@color/line"/>

</LinearLayout>