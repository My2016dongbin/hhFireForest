<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_news"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_marginBottom="5dp"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_time"
        android:layout_marginTop="15dp"
        android:textColor="@color/c7mid"
        android:layout_gravity="center_horizontal"
        android:textSize="13sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/news_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/fl_receive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/news_receive"
        android:paddingBottom="10dp"
        android:paddingEnd="15dp"
        android:paddingStart="15dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tv_receive_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="26dp"
            android:textColor="@color/c7"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/ll_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_gravity="bottom|right"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="13dp"
                android:scaleType="fitXY"
                android:src="@drawable/locations" />

            <TextView
                android:id="@+id/tv_receive_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textColor="@color/c5mid"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/ll_send"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_send_state"
            android:textSize="12sp"
            android:textColor="@color/c5mid"
            android:text="已发送"
            android:layout_marginEnd="10dp"
            android:paddingBottom="20dp"
            android:gravity="center_vertical|right"
            android:layout_width="100dp"
            android:layout_height="match_parent" />
        <FrameLayout
            android:id="@+id/fl_state"
            android:layout_marginEnd="10dp"
            android:layout_width="100dp"
            android:visibility="gone"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_send_state"
                android:layout_width="30dp"
                android:paddingBottom="14dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical|right"
                android:src="@drawable/locations"
                />
        </FrameLayout>
        <FrameLayout
            android:paddingTop="12dp"
            android:layout_gravity="end"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingBottom="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/news_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_send_content"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>