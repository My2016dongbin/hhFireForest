<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/white_border_conner"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_car"
            android:textColor="@color/bluedrak"
            android:textSize="18sp"
            android:text="驾车"
            android:background="@drawable/cikck_car"
            android:layout_marginStart="15dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_walk"
            android:textColor="@color/c7"
            android:textSize="18sp"
            android:text="步行"
            android:background="@drawable/cikck_walk"
            android:layout_marginStart="100dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/cha_guide"
            android:layout_gravity="top|right"
            android:src="@drawable/ic_cha"
            android:padding="15dp"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_start"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/c6"
            android:textSize="16sp"
            android:text="起点"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_start"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:text="请选择"
            android:layout_marginEnd="40dp"
            android:layout_gravity="right|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:src="@drawable/ic_right"
            android:padding="12dp"
            android:layout_gravity="right|center_vertical"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </FrameLayout>
    <View
        android:background="@color/c2"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="20dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <FrameLayout
        android:id="@+id/fl_end"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/c6"
            android:textSize="16sp"
            android:text="终点"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/tv_end"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:text="请选择"
            android:layout_marginEnd="40dp"
            android:layout_gravity="right|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:src="@drawable/ic_right"
            android:padding="12dp"
            android:layout_gravity="right|center_vertical"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_weight="4"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <!--<LinearLayout
            android:id="@+id/ll_clean_guide"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/clean"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <TextView
                android:text="清除"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>-->
        <TextView
            android:id="@+id/tv_guide"
            android:layout_weight="5"
            android:text="开始导航"
            android:gravity="center"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:textColor="@color/white"
            android:background="@drawable/btn_qidian"
            android:layout_width="0dp"
            android:layout_height="45dp"/>
    </LinearLayout>
</LinearLayout>