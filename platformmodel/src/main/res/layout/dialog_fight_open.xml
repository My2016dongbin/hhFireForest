<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/white_border_conner"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_title_open"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/cha_open"
            android:src="@drawable/ic_cha"
            android:padding="15dp"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:background="@drawable/trans_border_conner2"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_1"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/duiwu"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="防火队伍"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_2"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/duiyuan"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="防火队员"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_3"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/feiji"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="飞机"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/trans_border_conner3"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_4"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/hulin"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="护林员"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_5"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/xiaofang"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="消防车"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_6"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:padding="10dp"
            android:gravity="center_horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/jiuhu"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <TextView
                android:textColor="@color/c6"
                android:textSize="15sp"
                android:layout_marginTop="3dp"
                android:text="救护车"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_clean"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/clean"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <TextView
                android:text="清除"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_zhongdian"
            android:layout_weight="1"
            android:text="设为终点"
            android:gravity="center"
            android:layout_marginStart="20dp"
            android:textColor="@color/black"
            android:background="@drawable/btn_zhongdian"
            android:layout_width="0dp"
            android:layout_height="45dp"/>
        <TextView
            android:id="@+id/tv_qidian"
            android:layout_weight="1"
            android:text="设为起点"
            android:gravity="center"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:textColor="@color/white"
            android:background="@drawable/btn_qidian"
            android:layout_width="0dp"
            android:layout_height="45dp"/>
    </LinearLayout>
</LinearLayout>