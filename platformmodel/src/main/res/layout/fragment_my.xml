<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/theme_primary_top"
        >

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="我的"
            android:textColor="@color/c12"
            android:textSize="15sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/c12"
        android:layout_marginTop="10dp"
        android:padding="20dp">
        <ImageView
            android:id="@+id/touxiang_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_vertical"
            android:src="@mipmap/ic_launcher"/>
        <com.ruyiruyi.rylibrary.cell.ImageTextView
            android:id="@+id/touxiang_view"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            android:src="@mipmap/ic_launcher"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="110dp">
            <TextView
                android:id="@+id/name_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/c7"
                android:textSize="16sp"
                android:text=""/>

            <TextView
                android:id="@+id/bumen_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/c6"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:text=""/>

            <TextView
                android:id="@+id/dianhua_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/c6"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:text=""/>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_right"
            android:visibility="gone"
            android:layout_gravity="right|center_vertical"/>
    </FrameLayout>



    <LinearLayout
        android:id="@+id/change_password_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/c12"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        android:padding="20dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_password_my"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改密码"
            android:layout_marginLeft="10dp"
            android:textColor="@color/c7"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gengxin_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/c12"
        android:layout_marginTop="5dp"
        android:padding="20dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_update"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本更新"
            android:layout_marginLeft="10dp"
            android:textColor="@color/c7"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/guanyu_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/c12"
        android:layout_marginTop="5dp"
        android:padding="20dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_about"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关于"
            android:layout_marginLeft="10dp"
            android:textColor="@color/c7"
            android:textSize="14sp"/>
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@color/c12"
        android:padding="20dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="语音报警"
            android:textColor="@color/c7"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/baojing_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="10dp"
            android:checked="true"
            android:textColor="@color/theme_primary"
            android:thumb="@drawable/switch_white_circle_selector"
            android:track="@drawable/switch_selector_green" />
    </FrameLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@color/c12"
        android:padding="20dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="实时位置上传"
            android:textColor="@color/c7"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/weizhi_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginRight="10dp"
            android:checked="true"
            android:textColor="@color/theme_primary"
            android:thumb="@drawable/switch_white_circle_selector"
            android:track="@drawable/switch_selector_green" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/c12"
        android:layout_marginTop="40dp">
        <TextView
            android:id="@+id/out_login_button"
            android:layout_width="match_parent"
            android:padding="20dp"
            android:layout_height="match_parent"
            android:text="退出登录"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/c20"
            android:layout_gravity="center"/>
    </LinearLayout>


</LinearLayout>