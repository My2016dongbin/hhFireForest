<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_list_layout"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_primary_list">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/theme_primary_list">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="15sp"
            android:src="@drawable/ic_jiankong"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="摄像机列表"
            android:textSize="15sp"
            android:textColor="#568ED1"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="40dp"/>
        <ImageView
            android:id="@+id/list_dialog_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|right"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:src="@drawable/ic_list_button" />
    </FrameLayout>
    <LinearLayout
        android:visibility="gone"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="53dp">
        <LinearLayout
            android:id="@+id/ll_left"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tv_left"
                android:text="设备"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="50dp"/>
            <View
                android:id="@+id/v_left"
                android:background="@color/blue"
                android:layout_width="60dp"
                android:layout_gravity="center"
                android:layout_height="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll_right"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:id="@+id/tv_right"
                android:text="收藏"
                android:textColor="@color/c3"
                android:textSize="18sp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="50dp"/>
            <View
                android:id="@+id/v_right"
                android:background="@color/blue"
                android:layout_width="60dp"
                android:visibility="invisible"
                android:layout_gravity="center"
                android:layout_height="3dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/c6"
        android:layout_width="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="1dp"
        android:layout_height="0.5dp"/>
    <android.support.v4.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/sv_gridtrees"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </android.support.v4.widget.SwipeRefreshLayout>
</LinearLayout>