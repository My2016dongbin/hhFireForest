<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:orientation="vertical"
     android:background="#F2F2F2"
     
    >
    <Button
            android:id="@+id/rrr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
             android:background="#39B8B6"
            android:text="数据上报"/>
    
    
    
    
      <LinearLayout 
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F2F2F2"
    android:padding="5dp">
     <TextView
             android:id="@+id/tvqdcode"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="二维码编号" />
           <EditText
            android:id="@+id/qdcodeet"
            android:layout_width="120dp"
            android:layout_height="50dp"
           
            android:singleLine="true"
            android:background="@drawable/qq_edit_login"
            android:hint=""
            android:ems="10" >
            
    

            <requestFocus />
        </EditText>
        
                <Button
     android:id="@+id/btnScan"   
     android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="扫码"
      android:textColor="#FFFFFF"    
    android:background="@drawable/sharp"
     android:layout_marginLeft="20px"
   
   
     />
          
           </LinearLayout>
           
      
      
      
          <LinearLayout 
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F2F2F2"
    android:padding="5dp">
    
           <EditText
            android:id="@+id/qdcodeet1"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
           android:focusable="false"
            android:singleLine="true"
            android:background="@drawable/qq_edit_login"
            android:hint="起始日期"
             android:layout_weight="1"
            android:ems="10" >
            </EditText>
            
                <EditText
            android:id="@+id/qdcodeet2"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
           android:focusable="false"
            android:singleLine="true"
            android:background="@drawable/qq_edit_login"
            android:hint="结束日期"
             android:layout_weight="1"
            android:ems="10" >

          
        </EditText>
          
           </LinearLayout>
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
           
      
    
    
    <LinearLayout 
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F2F2F2"
    android:padding="5dp">
	
    <Button
     android:id="@+id/button"   
     android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="本机数据"
     android:textColor="#FFFFFF"            
              android:background="@drawable/sharp"
              android:layout_weight="1"
   
     />
    
      <Button
     android:id="@+id/button1"   
     android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:text="历史数据"
    android:textColor="#FFFFFF"            
              android:background="@drawable/sharp"
              android:layout_weight="1"
    
     />
      
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"       
              android:layout_marginLeft="10dp"     
              android:background="@drawable/sharp"
              android:layout_weight="1"
              android:text="回主界面"
           />
      
      
      
      </LinearLayout>
      
      <LinearLayout 
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F2F2F2"
    android:padding="5dp">
      
       <Button
            android:id="@+id/pre"
            android:layout_width="350px"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
              android:background="@drawable/sharp"
               android:layout_weight="1"
            android:text="上一页"/>
       
         
       <Button
            android:id="@+id/next"
            android:layout_width="350px"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
              android:background="@drawable/sharp"
               android:layout_weight="1"
                android:layout_marginLeft="20dp"    
            android:text="下一页"/>
       
          </LinearLayout>
       
         <Button
            android:id="@+id/Submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
             android:background="@drawable/sharp"
            android:text="本地数据提交"/>
         
         
           <LinearLayout 
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#F2F2F2"
    android:padding="5dp">
           <Button
            android:id="@+id/btnViewDetail"
             android:layout_width="350px"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
             android:background="@drawable/sharp"
              android:layout_weight="1"
            android:text="查看历史数据详情"/>
            <Button
            android:id="@+id/btnDH"
            android:layout_width="350px"
            android:layout_height="wrap_content"
             android:textColor="#FFFFFF"            
             android:background="@drawable/sharp"
              android:layout_weight="1"
               android:layout_marginLeft="20dp"    
            android:text="导航"/>
          </LinearLayout>
        
         
         
         <TextView
             android:id="@+id/msg"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="TextView" />
         
           <TextView
             android:id="@+id/pages"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="TextView" />
       
       
       
    <HorizontalScrollView
        android:id="@+id/layout"
        android:layout_width="fill_parent"
    android:layout_height="fill_parent" 
    android:visibility="invisible"
    >
    <LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
     >
   <LinearLayout
       android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" >
    <View style="@style/horizontal_layout"/>
    <View style="@style/horizontal_layout"/>
    <ListView 
    android:id="@+id/listview"   
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:cacheColorHint="#00000000"   
    />   
    
    
 
    <View style="@style/horizontal_layout"/>
    
     
   </LinearLayout>    

  
	</LinearLayout>	
	</HorizontalScrollView>    
	 
</LinearLayout>