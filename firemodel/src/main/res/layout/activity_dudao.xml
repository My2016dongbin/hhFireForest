<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c"
    android:orientation="vertical"
    tools:context=".ui.activity.FireMissionListActivity">
    <com.ruyiruyi.rylibrary.cell.ActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/view_date"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp">
            <TextView
                android:id="@+id/text_date"
                android:text="时间"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/c7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@drawable/dd_down"
                android:layout_marginStart="5dp"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </LinearLayout>
        <View
            android:background="@color/c"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:id="@+id/view_status"
            android:gravity="center"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp">
            <TextView
                android:id="@+id/text_status"
                android:text="任务状态"
                android:textSize="14sp"
                android:textColor="@color/c7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:src="@drawable/dd_down"
                android:layout_marginStart="5dp"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
        </LinearLayout>
    </LinearLayout>

    <android.support.v4.widget.SwipeRefreshLayout
        android:id="@+id/fire_mission_refresh_layout"
        android:background="@color/c"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/fire_mission_listview"
            android:background="@color/c"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
    </android.support.v4.widget.SwipeRefreshLayout>


</LinearLayout>
