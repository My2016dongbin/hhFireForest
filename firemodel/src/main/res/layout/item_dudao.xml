<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/dd_layout"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dd_back"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    android:layout_marginTop="10dp">
    <com.ruyiruyi.rylibrary.utils.CircleImageView
        android:id="@+id/dd_image"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        app:roundHeight="12dp"
        app:roundWidth="12dp"
        android:scaleType="centerCrop"
        />
    <LinearLayout
        android:background="@drawable/dd_back_linear"
        android:layout_marginStart="80dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/dd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="80dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/c7"
            />
        <TextView
            android:id="@+id/dd_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="40dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/c6"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/dd_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/dd_start"
        android:layout_gravity="end"
        android:textSize="12sp"
        android:textColor="@color/dd_start"
        />
    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:src="@drawable/dd_right"
        />

</FrameLayout>