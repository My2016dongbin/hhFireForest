<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c12"
    android:orientation="vertical"
    tools:context="com.haohai.platform.firelibrary.ui.activity.FireSceneActivity">
    <com.ruyiruyi.rylibrary.cell.ActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/c0">


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">

            <TextView
                android:id="@+id/add_fire_scene_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/conner_dialog_button_yes"
                android:gravity="center"
                android:paddingBottom="10dp"
                android:paddingTop="10dp"
                android:text="保存"
                android:textColor="#ffffff"
                android:textSize="16sp" />
        </FrameLayout>

        <com.ruyiruyi.rylibrary.cell.GradationScrollView
            android:id="@+id/scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="60dp"
            android:background="@color/c0"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ffffff"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="20dp"
                        android:text="现场情况"
                        android:textColor="@color/c6"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/fire_xcqk_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edit_bg_select_noline"
                        android:hint="请输入现场情况"
                        android:inputType="textMultiLine"
                        android:minHeight="50dp"
                        android:paddingBottom="5dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="5dp"
                        android:textColor="@color/c5"
                        android:textColorHint="@color/c4"
                        android:textCursorDrawable="@drawable/edit_reg_cursor_color"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/c1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingRight="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="20dp"
                        android:text="其他信息"
                        android:textColor="@color/c6"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/fire_qtqk_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edit_bg_select_noline"
                        android:hint="请输入其他信息"
                        android:inputType="textMultiLine"
                        android:minHeight="50dp"
                        android:paddingBottom="5dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="5dp"
                        android:textColor="@color/c5"
                        android:textColorHint="@color/c4"
                        android:textCursorDrawable="@drawable/edit_reg_cursor_color"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/c1" />
                </LinearLayout>
                <LinearLayout
                    android:paddingTop="15dp"
                    android:paddingBottom="15dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:text="是否真实"
                        android:textColor="@color/c6"
                        android:textSize="15sp" />
                    <View
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:layout_marginEnd="20dp"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/image_real"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:padding="5dp"
                            android:src="@drawable/yes"
                            android:scaleType="centerCrop"  />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="真实"
                            android:textColor="@color/c6"
                            android:textSize="14sp" />
                        <ImageView
                            android:id="@+id/image_fuck"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="30dp"
                            android:padding="5dp"
                            android:src="@drawable/no"
                            android:scaleType="centerCrop"  />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="虚警"
                            android:textColor="@color/c6"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="vertical">

                        <!--<TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="添加图片"
                            android:textColor="@color/c6"
                            android:textSize="15sp" />-->

                        <LinearLayout
                            android:id="@+id/photo_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <android.support.v7.widget.RecyclerView
                                android:id="@+id/phote_recycle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!--<TextView
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:text="上传视频"
                            android:textColor="@color/c6"
                            android:textSize="16sp" />-->

                        <ImageView
                            android:id="@+id/bofang_image"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_marginLeft="10dp"
                            android:src="@drawable/video_play_normal1"
                            android:scaleType="centerCrop"  />
                        <TextView
                            android:id="@+id/shipin_view"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="视频选择"
                            android:layout_marginLeft="5dp"
                            android:textColor="@color/c6"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>
        </com.ruyiruyi.rylibrary.cell.GradationScrollView>
    </FrameLayout>
</LinearLayout>
