<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_margin="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/white_coner_6"
                android:orientation="vertical">
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:text="选择地图应用"
                    android:textColor="@color/c6"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <View
                    android:background="@color/c1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/guide_local"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/click_back"
                    android:textStyle="bold"
                    android:text="内置导航"
                    android:textColor="@color/c7"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <View
                    android:background="@color/c1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/guide_a_map"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/click_back"
                    android:textStyle="bold"
                    android:text="高德地图"
                    android:textColor="@color/c7"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <View
                    android:background="@color/c1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/guide_bai_du"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/click_back"
                    android:textStyle="bold"
                    android:text="百度地图"
                    android:textColor="@color/c7"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <View
                    android:background="@color/c1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/guide_tencent"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/click_back"
                    android:textStyle="bold"
                    android:text="腾讯地图"
                    android:textColor="@color/c7"
                    android:textSize="14sp"
                    android:gravity="center"/>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/share_tencent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:background="@drawable/click_share"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/wechat"/>
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_marginStart="3dp"
                    android:textStyle="bold"
                    android:text="分享到微信"
                    android:textColor="@color/c56"
                    android:textSize="14sp"
                    android:gravity="center"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/white_coner_6"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/dismiss"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:textStyle="bold"
                    android:background="@drawable/click_back"
                    android:text="取消"
                    android:textColor="@color/c7"
                    android:textSize="14sp"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>


    </ScrollView>


</LinearLayout>