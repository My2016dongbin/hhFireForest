<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:background="@drawable/conner_dialog"
    android:orientation="vertical">


    <TextView
        android:id="@+id/error_title"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="火情判断结果确认"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        />

    <TextView
        android:id="@+id/error_text"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="您的火情判断与上次不符，请问您确定以本次判定结果为准吗？"
        android:textColor="@color/c6"
        android:textSize="14sp"
        />

   <LinearLayout
       android:gravity="center"
       android:layout_marginStart="30dp"
       android:layout_marginEnd="30dp"
       android:layout_marginTop="30dp"
       android:layout_marginBottom="20dp"
       android:layout_width="match_parent"
       android:layout_height="wrap_content">
       <TextView
           android:id="@+id/dismiss"
           android:layout_weight="1"
           android:layout_width="0dp"
           android:layout_height="45dp"
           android:background="@drawable/conner_dialog_button_no"
           android:text="取消"
           android:textColor="@color/theme_primary"
           android:textSize="15sp"
           android:gravity="center"/>
       <View
           android:layout_width="20dp"
           android:layout_height="match_parent"/>
       <TextView
           android:id="@+id/confirm"
           android:layout_weight="1"
           android:layout_width="0dp"
           android:layout_height="45dp"
           android:background="@drawable/conner_dialog_button_yes"
           android:text="确认"
           android:textColor="@color/white"
           android:textSize="15sp"
           android:gravity="center"/>
   </LinearLayout>


</LinearLayout>
